# Google Maps console on the NAS (gmap2.getcdn.link). Copy to .env next to docker-compose.yml.
# Type the secrets on the NAS; never send them through chat, email or git.

# The owner's way in to the console (at least 24 characters): openssl rand -hex 32
GM_ADMIN_TOKEN=
# Encrypts the scrapers' keys and signs console sign-ins: openssl rand -base64 32
GM_SECRET_KEY=

GM_PUBLIC_URL=https://gmap2.getcdn.link

# Where the database lives on the NAS (made in step 1 of README.md).
GM_DATA_PATH=/volume1/docker/gmap-console/data

# GET.route's Docker network on the NAS (the traffic-scraper is on it too), so
# the console reaches traffic-scraper by name. Its NAME, from:
#   sudo docker inspect traffic-scraper --format '{{range $k, $v := .NetworkSettings.Networks}}{{$k}} {{end}}'
GET_ROUTE_NETWORK=
