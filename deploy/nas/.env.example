# Copy to .env and fill in. Never commit .env.

# The secret your app sends in the X-Route-Key header. Make one with:
#   openssl rand -hex 32
# (or reuse GET.route's key so your app sends one key to both)
ROUTE_API_KEY=

# GET.route's Docker network, so GET.route's tunnel can reach this container.
# Find it with:
#   sudo docker inspect get-route-tunnel --format '{{range $k, $v := .NetworkSettings.Networks}}{{$k}} {{end}}'
GET_ROUTE_NETWORK=

# Only for its own tunnel (docker compose --profile own-tunnel up -d):
# Cloudflare Zero Trust > Networks > Tunnels > Create a tunnel > Docker,
# the token after --token. Leave empty when using GET.route's tunnel.
TUNNEL_TOKEN=

# Memory cap for the container (all Chrome windows + API).
MEM_LIMIT=8g

# Answer a repeat of the same trip from memory for this many seconds (0 = off).
CACHE_SECONDS=60

# Chrome window pool (see README.md, "How many windows"). Each open window
# answers one lookup at a time and uses about 400 MB.
CHROME_WINDOWS=40      # most windows open at once
WARM_WINDOWS=2         # always open, from start-up (GET.ride allows 3 s; a cold window needs longer)
BROWSER_IDLE=300       # close extra windows after this many idle seconds (0 = never)
WARM_ON_START=1
WAIT_FOR_CHROME=1      # seconds a lookup waits for a free window before a 503

# The port the scraper answers on the office network (for the Mac's console).
LAN_PORT=8001

# The answer's road shape (polyline): drop points within this many metres of a
# straight line (0 = every point Google sends).
POLYLINE_TOLERANCE=5
