# The Google Maps console on the Mac mini. Copy to .env in this folder
# (README.md makes it for you). Never send these through chat, email or git.

# The owner's way in to this console (at least 24 characters): openssl rand -hex 32
GM_ADMIN_TOKEN=
# Encrypts the scrapers' keys and signs console sign-ins: openssl rand -base64 32
GM_SECRET_KEY=

GM_PUBLIC_URL=https://gmap.getcdn.link

# The port on this Mac that the Cloudflare Tunnel sends gmap.getcdn.link to.
# (8000 is the scraper itself, 8100 GET.route's pool, 8200 GET.route's console.)
GM_PORT=8300
