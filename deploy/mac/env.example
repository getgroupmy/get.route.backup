# Traffic Scraper on the Mac mini (see README.md in this folder).
# install.sh copies this to .env (kept out of git) and fills in ROUTE_API_KEY.

PORT=8000

# The secret GET.ride sends in X-Route-Key. install.sh makes a new one; paste
# it into Admin > Settings > Fare AI provider > Google Maps servers.
ROUTE_API_KEY=

# Chrome window pool. Each open window answers one lookup at a time and uses
# about 400 MB. Start here, then set from a load test (README.md).
CHROME_WINDOWS=16      # most windows open at once
WARM_WINDOWS=4         # always open, from start-up
BROWSER_IDLE=300       # close extra windows after this many idle seconds
WARM_ON_START=1

# A lookup that finds every window busy waits this long, then answers 503.
# Short on the primary: GET.ride then still has time to ask the NAS.
WAIT_FOR_CHROME=1

# Answer a repeat of the same trip from memory for this many seconds.
CACHE_SECONDS=60

# The answer's road shape: drop points within this many metres of a line.
POLYLINE_TOLERANCE=5

# Pages Chrome saw when a lookup failed (relative to the repository).
DEBUG_DIR=deploy/mac/debug

# Keep headless Chrome away from the login keychain (no password prompts).
CHROME_EXTRA_ARGS="--use-mock-keychain --password-store=basic"
