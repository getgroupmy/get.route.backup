# Copy to .env and fill in. Never commit .env.

# The secret your app sends in the X-Route-Key header. Make one with:
#   openssl rand -hex 32
ROUTE_API_KEY=

# Cloudflare Zero Trust > Networks > Tunnels > Create a tunnel > Docker:
# the token after --token. Add ONE public hostname:
# traffic.getride.my -> http://traffic-scraper:8000
TUNNEL_TOKEN=

# Memory cap for the container (Chrome + API).
MEM_LIMIT=1g

# Answer a repeat of the same trip from memory for this many seconds (0 = off).
CACHE_SECONDS=60

# Close Chrome after this many seconds without a query.
BROWSER_IDLE=600
